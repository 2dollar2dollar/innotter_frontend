    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.16.1",
    "formik": "^2.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-imask": "^7.6.1",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.2.0",
